# Salin file ini ke .env.local untuk development lokal.
# Jangan isi secret di file ini dan jangan di-commit .env.local.

# Cloudflare R2 (foto produk partner)
# Untuk development lokal, isi dengan bucket dan token STAGING.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=alaka-partner-photos-staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
