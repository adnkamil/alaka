# Salin file ini ke .env.local untuk development lokal.
# Jangan isi secret di file ini dan jangan di-commit .env.local.

# Cloudflare R2 (semua file upload). Dua bucket, keduanya PRIVAT:
# - R2_PUBLIC_BUCKET : foto brand, banner event, logo & foto produk partner
# - R2_PRIVATE_BUCKET: bukti transfer langganan, tagihan, top up
# Token API harus punya akses Object Read & Write ke kedua bucket.
# Untuk development lokal, isi dengan bucket dan token STAGING.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=alaka-public-staging
R2_PRIVATE_BUCKET=alaka-private-staging
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# LEGACY, hanya selama masa migrasi (hapus setelah migrasi selesai):
# bucket lama foto produk partner, dipakai sebagai fallback baca/hapus.
R2_BUCKET=alaka-partner-photos-staging
# Untuk scripts/migrate-storage-to-r2.ts (membaca Netlify Blobs dari luar Netlify).
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
