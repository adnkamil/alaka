{
  "name": "alaka",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:neon": "node --env-file=.env.neon.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:neon-stg": "node --env-file=.env.neon.stg.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "perf:submit:stg": "node --env-file=.env.neon.stg.local node_modules/tsx/dist/cli.mjs scripts/simulate-submit-load.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:neon": "node --env-file=.env.neon.local node_modules/drizzle-kit/bin.cjs studio",
    "db:baseline": "tsx scripts/drizzle-baseline.ts",
    "db:seed-dummy": "tsx scripts/seed-dummy-data.ts",
    "db:seed-calendar": "tsx scripts/seed-calendar-events.ts",
    "db:seed-calendar:neon": "node --env-file=.env.neon.local node_modules/tsx/dist/cli.mjs scripts/seed-calendar-events.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@netlify/blobs": "^11.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.38.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4.1.18",
    "vite-plugin-pwa": "^1.3.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/eslint-config": "^0.5.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
